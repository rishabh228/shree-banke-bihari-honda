<div class="flex min-h-screen items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="mb-8 text-center">
      <%= link_to root_path, class: "inline-block" do %>
        <p class="font-display text-2xl font-bold text-honda-dark">Shree Banke Bihari Honda</p>
      <% end %>
    </div>

    <div class="card p-8 shadow-lg">
      <h1 class="font-display mb-6 text-xl font-semibold text-honda-dark">Forgot your password?</h1>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, class: "mb-1 block text-sm font-medium text-gray-700" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field w-full" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Send reset instructions", class: "btn-primary w-full cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
