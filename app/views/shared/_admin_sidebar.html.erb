<div class="flex h-full flex-col">
  <%# Brand %>
  <div class="flex h-16 shrink-0 items-center justify-between gap-2 border-b border-white/10 px-4 sm:px-5">
    <div class="flex min-w-0 items-center gap-3">
      <%= showroom_logo_tag(html_class: "h-9 w-auto object-contain") %>
      <div class="min-w-0">
        <p class="truncate font-display text-sm font-semibold text-white"><%= current_settings.showroom_name %></p>
        <p class="text-xs text-honda-gold">Admin Panel</p>
      </div>
    </div>
    <button type="button"
            data-action="click->admin-sidebar#close"
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-gray-400 hover:bg-white/10 hover:text-white lg:hidden"
            aria-label="Close menu">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <%# Navigation %>
  <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Admin navigation">
    <% nav_sections.each do |section| %>
      <% visible_items = section[:items].select do |item|
           if item[:policy]
             policy(item[:policy]).index?
           elsif item[:roles]
             item[:roles].any? { |role| current_user.public_send("#{role}?") }
           else
             true
           end
         end %>
      <% next if visible_items.empty? %>

      <div class="mb-6">
        <p class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-gray-500"><%= section[:label] %></p>
        <ul class="space-y-1">
          <% visible_items.each do |item| %>
            <% active = admin_nav_active?(item[:controller]) %>
            <li>
              <%= link_to item[:path],
                    class: "admin-nav-link #{active ? 'admin-nav-link-active' : ''}",
                    data: { action: "click->admin-sidebar#close" } do %>
                <svg class="h-5 w-5 shrink-0 <%= active ? 'text-honda-red' : 'text-gray-400' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="<%= item[:icon] %>"/>
                </svg>
                <%= item[:label] %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </nav>

  <%# Footer %>
  <div class="shrink-0 border-t border-white/10 p-4">
    <%= link_to root_path, target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-400 transition hover:bg-white/5 hover:text-white" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
      </svg>
      View Public Site
    <% end %>
  </div>
</div>
