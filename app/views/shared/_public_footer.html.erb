<footer class="mt-auto border-t border-gray-200 bg-honda-dark text-gray-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <%# Column 1 — Brand %>
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <% if current_settings.logo.attached? %>
            <%= image_tag current_settings.logo, alt: current_settings.showroom_name, class: "h-12 w-auto brightness-0 invert" %>
          <% else %>
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-honda-red font-display text-lg font-bold text-white">
              H
            </div>
          <% end %>
        </div>
        <h3 class="font-display text-lg font-semibold text-white"><%= current_settings.showroom_name %></h3>
        <p class="text-sm leading-relaxed text-gray-400">
          Your trusted authorized Honda two-wheeler dealership. Explore the latest models, exclusive offers, finance options, and expert service under one roof.
        </p>
      </div>

      <%# Column 2 — Quick Links %>
      <div>
        <h4 class="mb-4 font-display text-sm font-semibold uppercase tracking-wider text-honda-gold">Quick Links</h4>
        <ul class="space-y-2.5 text-sm">
          <li><%= link_to "All Bikes", bikes_path, class: "transition hover:text-white" %></li>
          <li><%= link_to "Current Offers", offers_path, class: "transition hover:text-white" %></li>
          <li><%= link_to "Accessories", accessories_path, class: "transition hover:text-white" %></li>
          <li><%= link_to "Finance Options", finance_path, class: "transition hover:text-white" %></li>
          <li><%= link_to "Insurance", insurance_path, class: "transition hover:text-white" %></li>
          <li><%= link_to "Book Test Ride", new_test_ride_path, class: "transition hover:text-white" %></li>
          <li><%= link_to "Service Booking", new_service_booking_path, class: "transition hover:text-white" %></li>
        </ul>
      </div>

      <%# Column 3 — Contact %>
      <div>
        <h4 class="mb-4 font-display text-sm font-semibold uppercase tracking-wider text-honda-gold">Contact Us</h4>
        <ul class="space-y-3 text-sm">
          <% if current_settings.address.present? %>
            <li class="flex gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-honda-red" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
              </svg>
              <span class="leading-relaxed"><%= simple_format(current_settings.address, {}, wrapper_tag: "span") %></span>
            </li>
          <% end %>
          <% if current_settings.phone.present? %>
            <li class="flex items-center gap-3">
              <svg class="h-5 w-5 shrink-0 text-honda-red" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
              </svg>
              <a href="tel:<%= current_settings.phone.gsub(/\s/, '') %>" class="transition hover:text-white"><%= current_settings.phone %></a>
            </li>
          <% end %>
          <% if current_settings.email.present? %>
            <li class="flex items-center gap-3">
              <svg class="h-5 w-5 shrink-0 text-honda-red" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
              </svg>
              <a href="mailto:<%= current_settings.email %>" class="transition hover:text-white"><%= current_settings.email %></a>
            </li>
          <% end %>
          <% if current_settings.google_map_link.present? %>
            <li>
              <%= link_to current_settings.google_map_link, target: "_blank", rel: "noopener noreferrer",
                    class: "inline-flex items-center gap-2 text-honda-gold transition hover:text-white" do %>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
                </svg>
                Get Directions
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>

      <%# Column 4 — Hours & Social %>
      <div>
        <h4 class="mb-4 font-display text-sm font-semibold uppercase tracking-wider text-honda-gold">Showroom Hours</h4>
        <% if current_settings.business_hours.present? %>
          <div class="mb-6 text-sm leading-relaxed text-gray-400">
            <%= simple_format(current_settings.business_hours) %>
          </div>
        <% else %>
          <p class="mb-6 text-sm text-gray-400">Mon – Sat: 9:00 AM – 7:00 PM<br>Sunday: 10:00 AM – 5:00 PM</p>
        <% end %>

        <h4 class="mb-3 font-display text-sm font-semibold uppercase tracking-wider text-honda-gold">Follow Us</h4>
        <div class="flex gap-3">
          <% if current_settings.facebook.present? %>
            <%= link_to current_settings.facebook, target: "_blank", rel: "noopener noreferrer",
                  class: "flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-gray-400 transition hover:bg-honda-red hover:text-white",
                  aria: { label: "Facebook" } do %>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <% end %>
          <% end %>
          <% if current_settings.instagram.present? %>
            <%= link_to current_settings.instagram, target: "_blank", rel: "noopener noreferrer",
                  class: "flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-gray-400 transition hover:bg-honda-red hover:text-white",
                  aria: { label: "Instagram" } do %>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.226-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            <% end %>
          <% end %>
          <% if current_settings.youtube.present? %>
            <%= link_to current_settings.youtube, target: "_blank", rel: "noopener noreferrer",
                  class: "flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-gray-400 transition hover:bg-honda-red hover:text-white",
                  aria: { label: "YouTube" } do %>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <% end %>
          <% end %>
          <% if current_settings.whatsapp.present? %>
            <%= link_to whatsapp_url(current_settings.whatsapp), target: "_blank", rel: "noopener noreferrer",
                  class: "flex h-10 w-10 items-center justify-center rounded-lg bg-white/5 text-gray-400 transition hover:bg-[#25D366] hover:text-white",
                  aria: { label: "WhatsApp" } do %>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# Bottom bar %>
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
      <p class="text-sm text-gray-500">
        &copy; <%= Time.current.year %> <%= current_settings.showroom_name %>. All rights reserved.
      </p>
      <div class="flex gap-6 text-sm">
        <%= link_to "Privacy Policy", privacy_path, class: "text-gray-500 transition hover:text-white" %>
        <%= link_to "Terms of Service", terms_path, class: "text-gray-500 transition hover:text-white" %>
      </div>
    </div>
  </div>
</footer>
