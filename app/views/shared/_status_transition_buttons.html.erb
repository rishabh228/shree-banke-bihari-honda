<%# locals: (record:, button_class:, inline: false, empty_message: "No further status changes available.") %>
<% next_statuses = allowed_status_transitions(record) %>

<% if next_statuses.any? %>
  <div class="<%= inline ? "flex flex-wrap gap-2" : "space-y-2" %>">
    <% next_statuses.each do |status| %>
      <%= button_to status.humanize.titleize, status_transition_path_for(record, status), method: :patch, class: button_class %>
    <% end %>
  </div>
<% else %>
  <p class="text-sm text-gray-500"><%= empty_message %></p>
<% end %>
