<%# locals: (unread_count: 0) %>
<%= link_to admin_notifications_path,
      class: "relative rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 hover:text-honda-red",
      title: "Notifications",
      data: {
        controller: "notification-badge",
        notification_badge_url_value: unread_count_admin_notifications_path,
        notification_badge_interval_value: 60000
      } do %>
  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
  </svg>
  <span data-notification-badge-target="count"
        class="absolute right-1 top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-honda-red px-1 text-[10px] font-bold text-white <%= "hidden" unless unread_count.to_i.positive? %>">
    <%= unread_count.to_i > 9 ? "9+" : unread_count %>
  </span>
<% end %>
