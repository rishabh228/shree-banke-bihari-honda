<% content_for :title, "Finance Options" %>
<% content_for :meta_description, "Flexible Honda bike finance and EMI plans at #{current_settings.showroom_name}. Quick loan approval with leading banks and NBFCs." %>

<section class="border-b border-gray-200 bg-gradient-to-br from-honda-dark via-gray-900 to-honda-red/30">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <p class="text-sm font-semibold uppercase tracking-widest text-honda-gold">Easy Ownership</p>
    <h1 class="mt-2 font-display text-3xl font-bold text-white sm:text-4xl">Honda Bike Finance</h1>
    <p class="mt-4 max-w-2xl text-gray-300">Drive home your dream Honda with flexible finance plans and quick loan processing through our banking partners at the showroom.</p>
  </div>
</section>

<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <%# Finance Information %>
    <div>
      <h2 class="font-display text-2xl font-bold text-honda-dark">Why Finance With Us?</h2>
      <p class="mt-3 text-gray-600">As an authorized Honda dealer, we work with leading banks and NBFCs to offer competitive interest rates and hassle-free documentation.</p>

      <div class="mt-8 space-y-4">
        <% [
          [ "Low Down Payment", "Start riding with minimal upfront cost — flexible down payment options on select models." ],
          [ "Quick Approval", "In-principle loan approval within 24 hours with minimal paperwork for salaried and self-employed customers." ],
          [ "Flexible Tenure", "Choose loan tenure from 12 to 48 months to match your monthly budget comfortably." ],
          [ "Competitive Rates", "Special interest rates negotiated with our partner lenders exclusively for Honda customers." ]
        ].each do |title, desc| %>
          <div class="flex gap-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-honda-red">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
            </div>
            <div>
              <h3 class="font-display font-semibold text-honda-dark"><%= title %></h3>
              <p class="mt-1 text-sm text-gray-600"><%= desc %></p>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-10 rounded-xl bg-gray-100 p-6">
        <h3 class="font-display font-semibold text-honda-dark">Documents Required</h3>
        <ul class="mt-4 grid gap-2 text-sm text-gray-600 sm:grid-cols-2">
          <% ["Identity proof (Aadhaar / PAN)", "Address proof", "Income proof (salary slip / ITR)", "Bank statements (3 months)", "Passport-size photographs"].each do |doc| %>
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-honda-red"></span>
              <%= doc %>
            </li>
          <% end %>
        </ul>
      </div>

      <% if @published_bikes.any? %>
        <div class="mt-10">
          <h3 class="font-display font-semibold text-honda-dark">Popular Models</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            <% @published_bikes.limit(8).each do |bike| %>
              <%= link_to bike.name, bike_path(bike), class: "rounded-full border border-gray-200 bg-white px-4 py-1.5 text-sm font-medium text-gray-700 transition hover:border-honda-red hover:text-honda-red" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Enquiry Form %>
    <div>
      <div class="card sticky top-24 p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold text-honda-dark">Get a Finance Quote</h2>
        <p class="mt-2 text-sm text-gray-500">Share your details and our finance team will call you with loan options available at the showroom.</p>
        <div class="mt-6">
          <%= render "public/shared/enquiry_form",
                enquiry: @enquiry,
                bikes: @published_bikes,
                form_url: enquiries_path,
                show_bike_field: true,
                submit_label: "Request Finance Quote" %>
        </div>
      </div>
    </div>
  </div>
</div>
