<% content_for :title, "Home" %>
<% gallery_banners = Banner.active_banners.for_section("gallery") %>
<% testimonial_banners = Banner.active_banners.for_section("testimonial") %>

<%# ── Hero Slider ── %>
<section class="relative overflow-hidden bg-honda-dark" aria-label="Featured promotions">
  <% if @banners.any? %>
    <div class="group relative">
      <div class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" id="hero-slider">
        <% @banners.each_with_index do |banner, index| %>
          <div class="relative min-w-full shrink-0 snap-center">
            <div class="relative aspect-[21/9] min-h-[320px] sm:min-h-[400px] lg:min-h-[520px]">
              <% if banner.image.attached? %>
                <%= image_tag banner.image, alt: banner.title.presence || "Hero banner", class: "absolute inset-0 h-full w-full object-cover" %>
              <% else %>
                <div class="absolute inset-0 bg-gradient-to-br from-honda-dark via-gray-900 to-honda-red/40"></div>
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-r from-honda-dark/90 via-honda-dark/60 to-transparent"></div>
              <div class="relative mx-auto flex h-full max-w-7xl items-center px-4 sm:px-6 lg:px-8">
                <div class="max-w-xl py-12 lg:max-w-2xl lg:py-16">
                  <% if banner.title.present? %>
                    <h1 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
                      <%= banner.title %>
                    </h1>
                  <% else %>
                    <h1 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
                      Welcome to <%= @settings.showroom_name %>
                    </h1>
                  <% end %>
                  <% if banner.subtitle.present? %>
                    <p class="mt-4 text-base leading-relaxed text-gray-200 sm:text-lg"><%= banner.subtitle %></p>
                  <% else %>
                    <p class="mt-4 text-base leading-relaxed text-gray-200 sm:text-lg">
                      Discover the latest Honda two-wheelers — premium performance, trusted service, and exclusive offers at your authorized dealership.
                    </p>
                  <% end %>
                  <div class="mt-8 flex flex-wrap gap-3">
                    <% if banner.link.present? %>
                      <%= link_to "Explore Now", banner.link, class: "btn-primary" %>
                    <% else %>
                      <%= link_to "View All Bikes", bikes_path, class: "btn-primary" %>
                    <% end %>
                    <%= link_to "Book Test Ride", new_test_ride_path, class: "btn-outline-light" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @banners.size > 1 %>
        <div class="absolute bottom-6 left-1/2 flex -translate-x-1/2 gap-2">
          <% @banners.each_with_index do |_, index| %>
            <button type="button"
                    onclick="document.getElementById('hero-slider').scrollTo({ left: document.getElementById('hero-slider').clientWidth * <%= index %>, behavior: 'smooth' })"
                    class="h-2 w-2 rounded-full bg-white/40 transition hover:bg-white/70 <%= 'bg-honda-red ring-2 ring-white/50 w-6' if index.zero? %>"
                    aria-label="Go to slide <%= index + 1 %>"></button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="relative min-h-[400px] bg-gradient-to-br from-honda-dark via-gray-900 to-honda-red lg:min-h-[520px]">
      <div class="mx-auto flex max-w-7xl items-center px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-widest text-honda-gold">Authorized Honda Dealer</p>
          <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
            Ride the Future with <%= @settings.showroom_name %>
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-gray-300">
            Explore our complete range of Honda motorcycles and scooters. Expert guidance, flexible finance, and world-class after-sales service — all under one roof.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <%= link_to "Browse Bikes", bikes_path, class: "btn-primary" %>
            <%= link_to "Current Offers", offers_path, class: "btn-outline-light" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</section>

<%# ── Quick Stats Bar ── %>
<section class="border-b border-gray-200 bg-white">
  <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-gray-100 sm:grid-cols-4">
    <% [
      [ "100+", "Happy Customers" ],
      [ "15+", "Honda Models" ],
      [ "Same Day", "Test Rides" ],
      [ "Expert", "Service Team" ]
    ].each do |stat, label| %>
      <div class="px-4 py-6 text-center sm:py-8">
        <p class="font-display text-2xl font-bold text-honda-red sm:text-3xl"><%= stat %></p>
        <p class="mt-1 text-xs font-medium uppercase tracking-wide text-gray-500 sm:text-sm"><%= label %></p>
      </div>
    <% end %>
  </div>
</section>

<%# ── Featured Bikes ── %>
<section class="py-16 lg:py-24" aria-labelledby="featured-bikes-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Our Collection</p>
        <h2 id="featured-bikes-heading" class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">Featured Honda Bikes</h2>
        <p class="mt-3 max-w-xl text-gray-600">Hand-picked models combining performance, efficiency, and Honda reliability.</p>
      </div>
      <%= link_to "View All Bikes", bikes_path, class: "btn-secondary shrink-0" %>
    </div>

    <% if @featured_bikes.any? %>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% @featured_bikes.each do |bike| %>
          <%= render "shared/bike_card", bike: bike, featured: true %>
        <% end %>
      </div>
    <% else %>
      <div class="mt-10">
        <%= render "shared/empty_state",
              title: "Bikes Coming Soon",
              message: "We are updating our showroom catalogue. Visit us or contact our team for the latest models.",
              icon: "bike",
              cta_text: "Contact Us",
              cta_path: contact_path %>
      </div>
    <% end %>
  </div>
</section>

<%# ── Latest Offers ── %>
<section class="bg-gray-100 py-16 lg:py-24" aria-labelledby="offers-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Limited Time</p>
      <h2 id="offers-heading" class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">Latest Offers</h2>
      <p class="mx-auto mt-3 max-w-2xl text-gray-600">Exclusive deals on select Honda models — finance assistance and seasonal promotions.</p>
    </div>

    <% if @offers.any? %>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% @offers.each do |offer| %>
          <article class="card group flex flex-col overflow-hidden transition hover:-translate-y-1 hover:shadow-lg">
            <div class="relative aspect-[16/10] overflow-hidden bg-honda-dark">
              <% if offer.banner.attached? %>
                <%= image_tag offer.banner, alt: offer.title, class: "h-full w-full object-cover transition duration-500 group-hover:scale-105" %>
              <% else %>
                <div class="flex h-full items-center justify-center bg-gradient-to-br from-honda-red to-honda-dark">
                  <span class="font-display text-4xl font-bold text-white/20">OFFER</span>
                </div>
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-t from-honda-dark/80 to-transparent"></div>
              <div class="absolute bottom-0 p-4">
                <h3 class="font-display text-lg font-semibold text-white"><%= offer.title %></h3>
                <% if offer.bike.present? %>
                  <p class="mt-1 text-sm text-gray-300"><%= offer.bike.name %></p>
                <% end %>
              </div>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <% if offer.description.present? %>
                <p class="line-clamp-3 flex-1 text-sm leading-relaxed text-gray-600"><%= offer.description %></p>
              <% end %>
              <div class="mt-4">
                <% if offer.bike.present? %>
                  <%= link_to "View Bike", bike_path(offer.bike), class: "btn-primary w-full justify-center text-sm" %>
                <% else %>
                  <%= link_to "Enquire Now", new_enquiry_path(source: "general"), class: "btn-primary w-full justify-center text-sm" %>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
      <div class="mt-10 text-center">
        <%= link_to "View All Offers", offers_path, class: "btn-secondary" %>
      </div>
    <% else %>
      <div class="mx-auto mt-10 max-w-lg">
        <%= render "shared/empty_state",
              title: "No Active Offers",
              message: "Check back soon for exciting promotions, or speak to our sales team for the best deal.",
              cta_text: "Contact Sales",
              cta_path: contact_path %>
      </div>
    <% end %>
  </div>
</section>

<%# ── Why Choose Us ── %>
<section class="py-16 lg:py-24" aria-labelledby="why-us-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Why Choose Us</p>
      <h2 id="why-us-heading" class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">The <%= @settings.showroom_name %> Advantage</h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        {
          title: "Authorized Dealer",
          desc: "Genuine Honda products, factory-trained technicians, and official warranty support you can trust.",
          icon: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
        },
        {
          title: "Easy Finance",
          desc: "Finance assistance with leading banks and NBFCs. Quick approval and minimal documentation at our showroom.",
          icon: "M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm6 0a9 9 0 11-18 0 9 9 0 0118 0z"
        },
        {
          title: "Expert Service",
          desc: "State-of-the-art service centre with genuine spare parts, periodic maintenance, and quick turnaround.",
          icon: "M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.88m-3.61-.617a2.548 2.548 0 010-3.586l6.837-5.88a2.548 2.548 0 013.586 3.586l-5.88 6.837"
        },
        {
          title: "Test Ride Ready",
          desc: "Experience your dream Honda before you buy. Same-day test rides available on most models.",
          icon: "M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"
        }
      ].each do |item| %>
        <div class="card p-6 transition hover:border-honda-red/30 hover:shadow-md">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-50 text-honda-red">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= item[:icon] %>"/>
            </svg>
          </div>
          <h3 class="mt-5 font-display text-lg font-semibold text-honda-dark"><%= item[:title] %></h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600"><%= item[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── Services Section ── %>
<section class="bg-honda-dark py-16 text-white lg:py-24" aria-labelledby="services-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-honda-gold">After Sales</p>
        <h2 id="services-heading" class="mt-2 font-display text-3xl font-bold sm:text-4xl">Complete Care for Your Honda</h2>
        <p class="mt-4 leading-relaxed text-gray-300">
          From free periodic service to paid repairs and warranty claims — our certified service advisors and technicians keep your Honda running at its best.
        </p>
        <ul class="mt-8 space-y-4">
          <% ["Free & paid periodic service", "Genuine Honda spare parts", "Insurance claim assistance", "Pickup & drop facility"].each do |item| %>
            <li class="flex items-center gap-3 text-sm text-gray-200">
              <svg class="h-5 w-5 shrink-0 text-honda-red" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              <%= item %>
            </li>
          <% end %>
        </ul>
        <div class="mt-10 flex flex-wrap gap-4">
          <%= link_to "Book Service", new_service_booking_path, class: "btn-primary" %>
          <%= link_to "Insurance", insurance_path, class: "btn-outline-light" %>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <% [
          [ "Free Service", "First 3 services complimentary on select models" ],
          [ "Express Service", "Quick turnaround for routine maintenance" ],
          [ "Body & Paint", "Accident repair with colour matching" ],
          [ "Accessories Fitment", "Genuine accessories installed by experts" ]
        ].each do |title, desc| %>
          <div class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
            <h3 class="font-display font-semibold text-honda-gold"><%= title %></h3>
            <p class="mt-2 text-sm text-gray-400"><%= desc %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# ── Accessories ── %>
<section class="py-16 lg:py-24" aria-labelledby="accessories-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Genuine Parts</p>
        <h2 id="accessories-heading" class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">Honda Accessories</h2>
        <p class="mt-3 max-w-xl text-gray-600">Enhance your ride with OEM-approved helmets, covers, guards, and more.</p>
      </div>
      <%= link_to "Shop All Accessories", accessories_path, class: "btn-secondary shrink-0" %>
    </div>

    <% if @accessories.any? %>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% @accessories.each do |accessory| %>
          <article class="card group overflow-hidden transition hover:-translate-y-1 hover:shadow-lg">
            <div class="relative aspect-square overflow-hidden bg-gray-100">
              <% if accessory.image.attached? %>
                <%= image_tag accessory.image, alt: accessory.name, class: "h-full w-full object-cover transition duration-500 group-hover:scale-105" %>
              <% else %>
                <div class="flex h-full items-center justify-center bg-gray-100 text-gray-300">
                  <svg class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                  </svg>
                </div>
              <% end %>
            </div>
            <div class="p-4">
              <h3 class="font-display font-semibold text-honda-dark"><%= accessory.name %></h3>
              <p class="mt-1 font-display text-lg font-bold text-honda-red"><%= format_price(accessory.price) %></p>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="mt-10">
        <%= render "shared/empty_state", message: "Accessories catalogue will be updated shortly.", cta_text: "Enquire", cta_path: new_enquiry_path(source: "accessories") %>
      </div>
    <% end %>
  </div>
</section>

<%# ── News ── %>
<% if @news_banners.any? %>
  <section class="bg-white py-16 lg:py-20" aria-labelledby="news-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Dealership</p>
          <h2 id="news-heading" class="mt-2 font-display text-3xl font-bold text-honda-dark">News & updates</h2>
        </div>
        <%= link_to "Gallery", gallery_path, class: "btn-secondary shrink-0" %>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <% @news_banners.each do |banner| %>
          <article class="card p-6">
            <h3 class="font-display font-semibold text-honda-dark"><%= banner.title.presence || "Update" %></h3>
            <% if banner.subtitle.present? %>
              <p class="mt-2 text-sm text-gray-600"><%= banner.subtitle %></p>
            <% end %>
            <% if banner.link.present? %>
              <%= link_to "Read more", banner.link, class: "mt-3 inline-block text-sm font-semibold text-honda-red hover:underline", target: "_blank", rel: "noopener noreferrer" %>
            <% end %>
          </article>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ── Testimonials (placeholder) ── %>
<section class="bg-gray-100 py-16 lg:py-24" aria-labelledby="testimonials-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Customer Stories</p>
      <h2 id="testimonials-heading" class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">What Our Riders Say</h2>
    </div>

    <% if testimonial_banners.any? %>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <% testimonial_banners.each do |banner| %>
          <figure class="card p-6">
            <% if banner.image.attached? %>
              <%= image_tag banner.image, alt: banner.title, class: "mb-4 h-12 w-12 rounded-full object-cover" %>
            <% end %>
            <blockquote class="text-sm leading-relaxed text-gray-600"><%= banner.subtitle.presence || banner.title %></blockquote>
            <% if banner.title.present? && banner.subtitle.present? %>
              <figcaption class="mt-4 font-display text-sm font-semibold text-honda-dark">— <%= banner.title %></figcaption>
            <% end %>
          </figure>
        <% end %>
      </div>
    <% else %>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <% [
          [ "Rahul S.", "Purchased Activa 6G", "Excellent buying experience! The team explained every finance option clearly and delivered on time." ],
          [ "Priya M.", "Booked Hornet 2.0", "Smooth test ride booking and transparent on-road pricing. Highly recommend this showroom." ],
          [ "Amit K.", "Service Customer", "Genuine parts, professional service advisors, and my bike was ready before the promised time." ]
        ].each do |name, context, quote| %>
          <figure class="card p-6">
            <div class="mb-4 flex text-honda-gold">
              <% 5.times do %>
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <% end %>
            </div>
            <blockquote class="text-sm leading-relaxed text-gray-600">&ldquo;<%= quote %>&rdquo;</blockquote>
            <figcaption class="mt-4">
              <p class="font-display text-sm font-semibold text-honda-dark"><%= name %></p>
              <p class="text-xs text-gray-500"><%= context %></p>
            </figcaption>
          </figure>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%# ── Gallery ── %>
<% if gallery_banners.any? %>
  <section class="py-16 lg:py-24" aria-labelledby="gallery-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Showroom</p>
        <h2 id="gallery-heading" class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">Gallery</h2>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 lg:gap-4">
        <% gallery_banners.each do |banner| %>
          <div class="group relative aspect-square overflow-hidden rounded-xl bg-gray-100">
            <% if banner.image.attached? %>
              <%= image_tag banner.image, alt: banner.title.presence || "Gallery image", class: "h-full w-full object-cover transition duration-500 group-hover:scale-110" %>
            <% end %>
            <% if banner.title.present? %>
              <div class="absolute inset-0 flex items-end bg-gradient-to-t from-honda-dark/70 to-transparent p-4 opacity-0 transition group-hover:opacity-100">
                <p class="text-sm font-medium text-white"><%= banner.title %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ── Contact Section ── %>
<section class="border-t border-gray-200 bg-white py-16 lg:py-24" aria-labelledby="contact-heading" id="contact">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Get In Touch</p>
        <h2 id="contact-heading" class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">Visit Our Showroom</h2>
        <p class="mt-4 text-gray-600">Have questions about a model, offer, or service? Send us a message and our team will respond promptly.</p>

        <dl class="mt-8 space-y-5">
          <% if @settings.address.present? %>
            <div class="flex gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-honda-red">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
              </div>
              <div>
                <dt class="text-sm font-semibold text-honda-dark">Address</dt>
                <dd class="mt-1 text-sm text-gray-600"><%= simple_format(@settings.address) %></dd>
              </div>
            </div>
          <% end %>
          <% if @settings.phone.present? %>
            <div class="flex gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-honda-red">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
              </div>
              <div>
                <dt class="text-sm font-semibold text-honda-dark">Phone</dt>
                <dd class="mt-1"><a href="tel:<%= @settings.phone.gsub(/\s/, '') %>" class="text-sm text-honda-red hover:underline"><%= @settings.phone %></a></dd>
              </div>
            </div>
          <% end %>
          <% if @settings.business_hours.present? %>
            <div class="flex gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-honda-red">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <dt class="text-sm font-semibold text-honda-dark">Business Hours</dt>
                <dd class="mt-1 text-sm text-gray-600"><%= simple_format(@settings.business_hours) %></dd>
              </div>
            </div>
          <% end %>
        </dl>

        <div class="mt-8 flex flex-wrap gap-3">
          <%= link_to "Full Contact Page", contact_path, class: "btn-secondary" %>
          <% if @settings.whatsapp.present? %>
            <%= link_to "WhatsApp Us", whatsapp_url(@settings.whatsapp), target: "_blank", rel: "noopener noreferrer", class: "btn-primary" %>
          <% end %>
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h3 class="font-display text-xl font-semibold text-honda-dark">Send an Enquiry</h3>
        <p class="mt-2 text-sm text-gray-500">Fill in your details and we&rsquo;ll get back to you within 24 hours.</p>
        <div class="mt-6">
          <%= render "public/shared/enquiry_form",
                enquiry: Enquiry.new(source: :general),
                form_url: enquiries_path,
                submit_label: "Send Message" %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── CTA Banner ── %>
<section class="bg-gradient-to-r from-honda-red to-red-800 py-12">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 text-center sm:px-6 lg:flex-row lg:px-8 lg:text-left">
    <div>
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Ready to ride your dream Honda?</h2>
      <p class="mt-2 text-red-100">Book a free test ride today or explore flexible finance options.</p>
    </div>
    <div class="flex shrink-0 flex-wrap justify-center gap-3">
      <%= link_to "Book Test Ride", new_test_ride_path, class: "inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-semibold text-honda-red shadow-sm transition hover:bg-gray-100" %>
      <%= link_to "Finance Options", finance_path, class: "btn-outline-light" %>
    </div>
  </div>
</section>
