<% content_for :title, "Gallery" %>
<% content_for :meta_description, "Showroom gallery and updates from #{current_settings.showroom_name}." %>

<section class="border-b border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Showroom</p>
    <h1 class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">Gallery</h1>
    <p class="mt-3 max-w-2xl text-gray-600">Photos, events, and news from our authorized Honda dealership.</p>
  </div>
</section>

<% if @news_banners.any? %>
  <section class="border-b border-gray-100 bg-gray-50 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-honda-dark">News & updates</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <% @news_banners.each do |banner| %>
          <article class="card overflow-hidden">
            <% if banner.image.attached? %>
              <%= image_tag banner.image, alt: banner.title, class: "h-40 w-full object-cover" %>
            <% end %>
            <div class="p-5">
              <h3 class="font-display font-semibold text-honda-dark"><%= banner.title.presence || "Update" %></h3>
              <% if banner.subtitle.present? %>
                <p class="mt-2 text-sm text-gray-600"><%= banner.subtitle %></p>
              <% end %>
              <% if banner.link.present? %>
                <%= link_to "Read more", banner.link, class: "mt-3 inline-block text-sm font-semibold text-honda-red hover:underline", target: "_blank", rel: "noopener noreferrer" %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <% images = [] %>
  <% @gallery_banners.each { |banner| images << [ banner.image, banner.title ] if banner.image.attached? } %>
  <% @media_assets.each { |asset| images << [ asset.file, asset.title ] if asset.file.attached? } %>

  <% if images.any? %>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      <% images.each do |file, title| %>
        <figure class="group relative aspect-square overflow-hidden rounded-xl bg-gray-100">
          <%= image_tag file, alt: title.presence || "Gallery image", class: "h-full w-full object-cover transition duration-500 group-hover:scale-105" %>
          <% if title.present? %>
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-honda-dark/80 p-3 text-sm text-white opacity-0 transition group-hover:opacity-100"><%= title %></figcaption>
          <% end %>
        </figure>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", title: "Gallery coming soon", message: "Showroom photos will appear here once they are uploaded from Admin → Media Library or Banners (gallery section).", cta_text: "Contact us", cta_path: contact_path %>
  <% end %>
</div>
