<% content_for :title, @page.title %>
<% content_for :meta_description, "Learn more from #{current_settings.showroom_name}." %>

<section class="border-b border-gray-200 bg-white">
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <h1 class="font-display text-3xl font-bold text-honda-dark sm:text-4xl"><%= @page.title %></h1>
    <p class="mt-3 text-sm text-gray-500">Last updated: <%= @page.updated_at.strftime("%d %B %Y") %></p>
  </div>
</section>

<div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <% if @page.body.present? %>
    <article class="trix-content text-gray-600">
      <%= @page.body %>
    </article>
  <% else %>
    <p class="text-gray-600">This page has no content yet. Please check back shortly.</p>
  <% end %>

  <div class="mt-12 flex flex-wrap gap-4">
    <%= link_to "Contact Us", contact_path, class: "btn-primary" %>
    <%= link_to "Browse Bikes", bikes_path, class: "btn-secondary" %>
  </div>
</div>
