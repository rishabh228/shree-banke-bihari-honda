<% content_for :title, "Contact Us" %>
<% content_for :meta_description, "Contact #{current_settings.showroom_name} for Honda bike enquiries, test rides, service bookings, and showroom directions." %>

<section class="border-b border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <p class="text-sm font-semibold uppercase tracking-widest text-honda-red">Reach Us</p>
    <h1 class="mt-2 font-display text-3xl font-bold text-honda-dark sm:text-4xl">Contact Us</h1>
    <p class="mt-3 max-w-2xl text-gray-600">Visit our showroom, call us, or send a message — we&rsquo;re here to help with sales, service, finance, and insurance.</p>
  </div>
</section>

<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <%# Contact Details %>
    <div>
      <h2 class="font-display text-xl font-bold text-honda-dark">Showroom Details</h2>

      <dl class="mt-6 space-y-6">
        <% if current_settings.address.present? %>
          <div class="flex gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-honda-red">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            </div>
            <div>
              <dt class="text-sm font-semibold text-honda-dark">Address</dt>
              <dd class="mt-1 text-sm leading-relaxed text-gray-600"><%= simple_format(current_settings.address) %></dd>
            </div>
          </div>
        <% end %>

        <% if current_settings.phone.present? %>
          <div class="flex gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-honda-red">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
            </div>
            <div>
              <dt class="text-sm font-semibold text-honda-dark">Phone</dt>
              <dd class="mt-1"><a href="tel:<%= current_settings.phone.gsub(/\s/, '') %>" class="text-sm font-medium text-honda-red hover:underline"><%= current_settings.phone %></a></dd>
            </div>
          </div>
        <% end %>

        <% if current_settings.email.present? %>
          <div class="flex gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-honda-red">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            </div>
            <div>
              <dt class="text-sm font-semibold text-honda-dark">Email</dt>
              <dd class="mt-1"><a href="mailto:<%= current_settings.email %>" class="text-sm font-medium text-honda-red hover:underline"><%= current_settings.email %></a></dd>
            </div>
          </div>
        <% end %>

        <% if current_settings.business_hours.present? %>
          <div class="flex gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-honda-red">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <dt class="text-sm font-semibold text-honda-dark">Business Hours</dt>
              <dd class="mt-1 text-sm text-gray-600"><%= simple_format(current_settings.business_hours) %></dd>
            </div>
          </div>
        <% end %>
      </dl>

      <div class="mt-8 flex flex-wrap gap-3">
        <% if current_settings.whatsapp.present? %>
          <%= link_to "WhatsApp", whatsapp_url(current_settings.whatsapp), target: "_blank", rel: "noopener noreferrer", class: "btn-primary" %>
        <% end %>
        <%= link_to "Book Test Ride", new_test_ride_path, class: "btn-secondary" %>
        <%= link_to "Book Service", new_service_booking_path, class: "btn-secondary" %>
      </div>

      <%# Map %>
      <% if current_settings.google_map_link.present? %>
        <div class="mt-10">
          <h2 class="font-display text-lg font-semibold text-honda-dark">Find Us on Map</h2>
          <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 shadow-sm">
            <iframe
              src="<%= current_settings.google_map_link %>"
              width="100%"
              height="320"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="<%= current_settings.showroom_name %> location map"
              class="w-full"></iframe>
          </div>
          <p class="mt-3 text-center">
            <%= link_to "Open in Google Maps", current_settings.google_map_link, target: "_blank", rel: "noopener noreferrer", class: "text-sm font-medium text-honda-red hover:underline" %>
          </p>
        </div>
      <% end %>
    </div>

    <%# Contact Form %>
    <div>
      <div class="card p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold text-honda-dark">Send a Message</h2>
        <p class="mt-2 text-sm text-gray-500">We typically respond within one business day.</p>
        <div class="mt-6">
          <%= render "public/shared/enquiry_form",
                enquiry: @enquiry,
                form_url: contact_path,
                submit_label: "Send Message" %>
        </div>
      </div>
    </div>
  </div>
</div>
