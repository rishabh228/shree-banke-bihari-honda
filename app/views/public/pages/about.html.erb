<% content_for :title, @page&.title.presence || "About Us" %>
<% content_for :meta_description, "Learn about #{current_settings.showroom_name} — your authorized Honda two-wheeler dealership." %>

<section class="border-b border-gray-200 bg-gradient-to-br from-honda-dark to-gray-900">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <p class="text-sm font-semibold uppercase tracking-widest text-honda-gold">Our Story</p>
    <h1 class="mt-2 font-display text-3xl font-bold text-white sm:text-4xl"><%= @page&.title.presence || "About #{current_settings.showroom_name}" %></h1>
  </div>
</section>

<div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <% if @page&.body.present? %>
    <article class="trix-content text-gray-600">
      <%= @page.body %>
    </article>
  <% else %>
    <div class="space-y-8">
      <div class="card p-8">
        <h2 class="font-display text-2xl font-bold text-honda-dark">Welcome to <%= current_settings.showroom_name %></h2>
        <p class="mt-4 leading-relaxed text-gray-600">
          We are a proud authorized Honda two-wheeler dealership committed to delivering exceptional buying and ownership experiences. From the latest motorcycles and scooters to genuine accessories, flexible finance, and expert after-sales service — we are your one-stop Honda destination.
        </p>
        <p class="mt-4 leading-relaxed text-gray-600">
          Our team of trained sales advisors and certified technicians ensures you receive honest guidance, transparent pricing, and reliable support at every step of your Honda journey.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <% [
          [ "Authorized Dealer", "100% genuine Honda products and warranty" ],
          [ "Customer First", "Transparent pricing and honest recommendations" ],
          [ "Expert Service", "Factory-trained technicians and OEM parts" ]
        ].each do |title, desc| %>
          <div class="rounded-xl border border-gray-200 bg-white p-6 text-center shadow-sm">
            <h3 class="font-display font-semibold text-honda-dark"><%= title %></h3>
            <p class="mt-2 text-sm text-gray-600"><%= desc %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-12 flex flex-wrap gap-4">
    <%= link_to "Browse Bikes", bikes_path, class: "btn-primary" %>
    <%= link_to "Contact Us", contact_path, class: "btn-secondary" %>
    <%= link_to "Book Test Ride", new_test_ride_path, class: "btn-secondary" %>
  </div>
</div>
