<% content_for :title, "Two Wheeler Insurance" %>
<% content_for :meta_description, "Comprehensive and third-party Honda bike insurance at #{current_settings.showroom_name}. Renewals, claims assistance, and zero-dep cover." %>

<section class="border-b border-gray-200 bg-gradient-to-br from-honda-dark via-gray-900 to-sky-900/40">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <p class="text-sm font-semibold uppercase tracking-widest text-honda-gold">Ride Protected</p>
    <h1 class="mt-2 font-display text-3xl font-bold text-white sm:text-4xl">Two Wheeler Insurance</h1>
    <p class="mt-4 max-w-2xl text-gray-300">Protect your Honda with comprehensive insurance plans. New policy, renewal, and claim assistance — all handled at our showroom.</p>
  </div>
</section>

<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <%# Insurance Information %>
    <div>
      <h2 class="font-display text-2xl font-bold text-honda-dark">Insurance Plans We Offer</h2>
      <p class="mt-3 text-gray-600">Choose from leading insurance providers with plans tailored for Honda motorcycles and scooters.</p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <% [
          [ "Third Party", "Mandatory legal cover for third-party liability. Affordable annual premium for all vehicle types.", "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" ],
          [ "Comprehensive", "Covers own damage, theft, natural calamities, and third-party liability in one policy.", "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" ],
          [ "Zero Depreciation", "Full claim amount without depreciation deduction on parts during repairs.", "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.172-.879-1.172-2.303 0-3.182s2.9-.879 4.242 0l.879.659" ],
          [ "Personal Accident", "Mandatory PA cover for owner-driver as per IRDAI regulations.", "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" ]
        ].each do |title, desc, icon| %>
          <div class="card p-5">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-sky-50 text-sky-700">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/>
              </svg>
            </div>
            <h3 class="mt-4 font-display font-semibold text-honda-dark"><%= title %></h3>
            <p class="mt-2 text-sm text-gray-600"><%= desc %></p>
          </div>
        <% end %>
      </div>

      <div class="mt-10">
        <h3 class="font-display text-lg font-semibold text-honda-dark">Our Insurance Services</h3>
        <ul class="mt-4 space-y-3">
          <% ["New vehicle insurance at time of purchase", "Policy renewal before expiry", "Claim filing and workshop coordination", "Add-on covers: engine protect, roadside assistance", "Instant policy issuance for select insurers"].each do |item| %>
            <li class="flex items-start gap-3 text-sm text-gray-600">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-honda-red" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              <%= item %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <%# Enquiry Form %>
    <div>
      <div class="card sticky top-24 p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold text-honda-dark">Insurance Enquiry</h2>
        <p class="mt-2 text-sm text-gray-500">Tell us about your vehicle and we&rsquo;ll share the best insurance quotes and renewal options.</p>
        <div class="mt-6">
          <%= render "public/shared/enquiry_form",
                enquiry: @enquiry,
                bikes: @published_bikes,
                form_url: enquiries_path,
                show_bike_field: true,
                submit_label: "Get Insurance Quote" %>
        </div>
      </div>
    </div>
  </div>
</div>
