<%= form_with model: [:admin, sale], class: "space-y-8" do |f| %>
  <% if sale.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <ul class="list-disc pl-5"><% sale.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="card p-6">
    <h2 class="font-display mb-4 text-lg font-semibold text-honda-dark">Customer</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div><%= f.label :customer_name, class: "mb-1 block text-sm font-medium" %><%= f.text_field :customer_name, class: "input-field w-full" %></div>
      <div><%= f.label :phone, class: "mb-1 block text-sm font-medium" %><%= f.telephone_field :phone, class: "input-field w-full" %></div>
      <div><%= f.label :email, class: "mb-1 block text-sm font-medium" %><%= f.email_field :email, class: "input-field w-full" %></div>
      <div class="sm:col-span-2"><%= f.label :address, class: "mb-1 block text-sm font-medium" %><%= f.text_area :address, rows: 2, class: "input-field w-full" %></div>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="font-display mb-4 text-lg font-semibold text-honda-dark">Vehicle & Executive</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :bike_id, "Bike", class: "mb-1 block text-sm font-medium" %>
        <%= f.collection_select :bike_id, @bikes, :id, :name, { include_blank: "Select bike" }, class: "input-field w-full" %>
      </div>
      <div>
        <%= f.label :bike_variant_id, "Variant", class: "mb-1 block text-sm font-medium" %>
        <%= f.collection_select :bike_variant_id, @bike_variants, :id, ->(v) { "#{v.bike.name} — #{v.name} (#{v.color})" }, { include_blank: "Select variant" }, class: "input-field w-full" %>
      </div>
      <div>
        <%= f.label :sales_executive_id, "Sales Executive", class: "mb-1 block text-sm font-medium" %>
        <%= f.collection_select :sales_executive_id, @sales_executives, :id, :name, {}, class: "input-field w-full" %>
      </div>
      <div>
        <%= f.label :status, class: "mb-1 block text-sm font-medium" %>
        <%= f.select :status, Sale.statuses.map { |k, v| [k.humanize.titleize, k] }, {}, class: "input-field w-full" %>
      </div>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="font-display mb-4 text-lg font-semibold text-honda-dark">Pricing</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div><%= f.label :ex_showroom_price, "Ex-Showroom (incl. GST)", class: "mb-1 block text-sm font-medium" %><%= f.number_field :ex_showroom_price, step: 1, class: "input-field w-full" %></div>
      <div><%= f.label :insurance, "Insurance (collected)", class: "mb-1 block text-sm font-medium" %><%= f.number_field :insurance, step: 1, class: "input-field w-full" %></div>
      <div><%= f.label :rto, "RTO (collected)", class: "mb-1 block text-sm font-medium" %><%= f.number_field :rto, step: 1, class: "input-field w-full" %></div>
      <div><%= f.label :handling_charge, "Handling / documentation", class: "mb-1 block text-sm font-medium" %><%= f.number_field :handling_charge, step: 1, class: "input-field w-full" %></div>
      <div><%= f.label :accessories_charge, "Accessories pack", class: "mb-1 block text-sm font-medium" %><%= f.number_field :accessories_charge, step: 1, class: "input-field w-full" %></div>
      <div><%= f.label :discount_percent, "Discount % (on ex-showroom)", class: "mb-1 block text-sm font-medium" %><%= f.number_field :discount_percent, step: 0.01, min: 0, max: 100, class: "input-field w-full" %></div>
      <div><%= f.label :discount_amount, "Extra discount (₹)", class: "mb-1 block text-sm font-medium" %><%= f.number_field :discount_amount, step: 1, min: 0, class: "input-field w-full" %></div>
      <div><%= f.label :total_price, "Total On-Road", class: "mb-1 block text-sm font-medium" %><%= f.number_field :total_price, step: 1, class: "input-field w-full" %></div>
      <div><%= f.label :booking_amount, "Booking Amount", class: "mb-1 block text-sm font-medium" %><%= f.number_field :booking_amount, step: 1, class: "input-field w-full" %></div>
    </div>
    <p class="mt-2 text-xs text-gray-500">Selecting a variant fills prices once. Discount % and extra ₹ come off ex-showroom (before GST split). Total on-road is recalculated from discounted ex-showroom + insurance + RTO + handling + accessories pack + accessory lines.</p>
  </div>

  <div class="card p-6">
    <h2 class="font-display mb-4 text-lg font-semibold text-honda-dark">Payment & Delivery</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div><%= f.label :payment_mode, class: "mb-1 block text-sm font-medium" %><%= f.select :payment_mode, Sale.payment_modes.map { |k, _| [k.humanize.titleize, k] }, {}, class: "input-field w-full" %></div>
      <div><%= f.label :finance_partner, class: "mb-1 block text-sm font-medium" %><%= f.text_field :finance_partner, class: "input-field w-full", placeholder: "If finance" %></div>
      <div><%= f.label :quoted_on, class: "mb-1 block text-sm font-medium" %><%= f.date_field :quoted_on, class: "input-field w-full" %></div>
      <div><%= f.label :booked_on, class: "mb-1 block text-sm font-medium" %><%= f.date_field :booked_on, class: "input-field w-full" %></div>
      <div><%= f.label :delivery_date, class: "mb-1 block text-sm font-medium" %><%= f.date_field :delivery_date, class: "input-field w-full" %></div>
      <div><%= f.label :chassis_number, class: "mb-1 block text-sm font-medium" %><%= f.text_field :chassis_number, class: "input-field w-full" %></div>
      <div><%= f.label :engine_number, class: "mb-1 block text-sm font-medium" %><%= f.text_field :engine_number, class: "input-field w-full" %></div>
      <div class="sm:col-span-2"><%= f.label :notes, class: "mb-1 block text-sm font-medium" %><%= f.text_area :notes, rows: 3, class: "input-field w-full" %></div>
    </div>
    <p class="mt-2 text-xs text-gray-500">Prefer allotting a chassis from stock on the sale page. Manual chassis/engine is allowed for legacy punching.</p>
  </div>

  <div class="card p-6">
    <h2 class="font-display mb-4 text-lg font-semibold text-honda-dark">Buyer tax & finance</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div><%= f.label :buyer_gstin, "Buyer GSTIN (B2B)", class: "mb-1 block text-sm font-medium" %><%= f.text_field :buyer_gstin, class: "input-field w-full", maxlength: 15 %></div>
      <div><%= f.label :buyer_pan, "Buyer PAN", class: "mb-1 block text-sm font-medium" %><%= f.text_field :buyer_pan, class: "input-field w-full", maxlength: 10 %></div>
      <div><%= f.label :buyer_state, class: "mb-1 block text-sm font-medium" %><%= f.text_field :buyer_state, class: "input-field w-full", placeholder: "Leave blank for same state as showroom" %></div>
      <div><%= f.label :buyer_state_code, "Buyer GST state code", class: "mb-1 block text-sm font-medium" %><%= f.text_field :buyer_state_code, class: "input-field w-full", maxlength: 2, placeholder: "09" %></div>
      <div><%= f.label :loan_amount, class: "mb-1 block text-sm font-medium" %><%= f.number_field :loan_amount, step: 1, class: "input-field w-full" %></div>
      <div><%= f.label :down_payment, class: "mb-1 block text-sm font-medium" %><%= f.number_field :down_payment, step: 1, class: "input-field w-full" %></div>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit sale.persisted? ? "Update Sale" : "Create Sale", class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancel", sale.persisted? ? admin_sale_path(sale) : admin_sales_path, class: "btn-secondary" %>
  </div>
<% end %>
