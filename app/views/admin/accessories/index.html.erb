<% content_for :page_title, "Accessories" %>
<% content_for :page_subtitle, "Manage accessories inventory" %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <%= search_form_for @q, url: admin_accessories_path, class: "flex flex-wrap items-end gap-3" do |f| %>
    <div>
      <%= f.label :name_cont, "Name", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.search_field :name_cont, class: "input-field w-48", placeholder: "Search..." %>
    </div>
    <div>
      <%= f.label :status_eq, "Status", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.select :status_eq, Accessory.statuses.map { |k, v| [k.humanize.titleize, v] }, { include_blank: "All" }, class: "input-field w-36" %>
    </div>
    <div class="flex gap-2">
      <%= f.submit "Search", class: "btn-primary" %>
      <%= link_to "Reset", admin_accessories_path, class: "btn-secondary" %>
    </div>
  <% end %>
  <%= link_to "Add Accessory", new_admin_accessory_path, class: "btn-primary shrink-0" %>
</div>

<% if @accessories.any? %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Accessory</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Price</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Stock</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Status</th>
            <th class="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @accessories.each do |accessory| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <% if accessory.image.attached? %>
                    <%= image_tag accessory.image, class: "h-10 w-10 rounded-lg object-cover" %>
                  <% else %>
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100 text-xs text-gray-400">—</div>
                  <% end %>
                  <div>
                    <div class="text-sm font-semibold text-honda-dark"><%= accessory.name %></div>
                    <% if accessory.description.present? %>
                      <div class="max-w-xs truncate text-xs text-gray-500"><%= accessory.description %></div>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-sm font-medium text-honda-dark"><%= format_price(accessory.price) %></td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= accessory.stock %></td>
              <td class="px-6 py-4"><%= render "shared/status_badge", status: accessory.status %></td>
              <td class="px-6 py-4 text-right text-sm">
                <%= link_to "Edit", edit_admin_accessory_path(accessory), class: "font-semibold text-honda-red hover:text-red-700" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.pages > 1 %><div class="mt-6 flex justify-center"><%== pagy_nav(@pagy) %></div><% end %>
<% else %>
  <%= render "shared/empty_state", title: "No accessories found", message: "Add accessories to your inventory.", cta_text: "Add Accessory", cta_path: new_admin_accessory_path %>
<% end %>
