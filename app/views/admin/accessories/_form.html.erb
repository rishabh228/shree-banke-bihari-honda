<%= form_with model: [:admin, accessory], class: "space-y-6" do |f| %>
  <% if accessory.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <h3 class="text-sm font-semibold text-red-800"><%= pluralize(accessory.errors.count, "error") %> prohibited this accessory from being saved:</h3>
      <ul class="mt-2 list-inside list-disc text-sm text-red-700">
        <% accessory.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="card p-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="md:col-span-2">
        <%= f.label :name, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, class: "input-field", required: true %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :description, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_area :description, rows: 4, class: "input-field" %>
      </div>
      <div>
        <%= f.label :price, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.number_field :price, step: 0.01, min: 0, class: "input-field", required: true %>
      </div>
      <div>
        <%= f.label :stock, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.number_field :stock, min: 0, class: "input-field", required: true %>
      </div>
      <div>
        <%= f.label :status, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.select :status, Accessory.statuses.keys.map { |s| [s.humanize.titleize, s] }, {}, class: "input-field" %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :image, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <% if accessory.image.attached? %>
          <div class="mb-3"><%= image_tag accessory.image, class: "h-24 w-24 rounded-lg object-cover" %></div>
        <% end %>
        <%= f.file_field :image, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:rounded-lg file:border-0 file:bg-honda-red file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-red-700" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancel", admin_accessories_path, class: "btn-secondary" %>
  </div>
<% end %>
