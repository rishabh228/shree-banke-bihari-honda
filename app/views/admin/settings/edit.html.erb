<% content_for :page_title, "Settings" %>
<% content_for :page_subtitle, "Showroom and contact configuration" %>

<%= form_with model: @setting, url: admin_settings_path, method: :patch, class: "space-y-6" do |f| %>
  <% if @setting.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <h3 class="text-sm font-semibold text-red-800"><%= pluralize(@setting.errors.count, "error") %> prohibited settings from being saved:</h3>
      <ul class="mt-2 list-inside list-disc text-sm text-red-700">
        <% @setting.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="card p-6">
    <h2 class="font-display text-lg font-semibold text-honda-dark">Branding</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= f.label :showroom_name, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :showroom_name, class: "input-field", required: true %>
      </div>
      <div>
        <%= f.label :legal_name, "Legal / GST name", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :legal_name, class: "input-field", placeholder: "Registered name on GSTIN" %>
      </div>
      <div>
        <%= f.label :dealer_code, "Honda dealer code", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :dealer_code, class: "input-field" %>
      </div>
      <div>
        <%= f.label :logo, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <% if @setting.logo.attached? %>
          <div class="mb-3"><%= image_tag @setting.logo, class: "h-16 w-auto rounded-lg border border-gray-200 bg-white p-2" %></div>
        <% end %>
        <%= f.file_field :logo, accept: "image/png,image/jpeg,image/jpg", class: "block w-full text-sm text-gray-500 file:mr-4 file:rounded-lg file:border-0 file:bg-honda-red file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-red-700" %>
        <p class="mt-2 text-xs text-gray-500">PNG or JPEG prints on tax invoices, receipts, and job cards as the Honda dealer letterhead. SVG is used on the website only.</p>
      </div>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="font-display text-lg font-semibold text-honda-dark">Contact Information</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="md:col-span-2">
        <%= f.label :address, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_area :address, rows: 3, class: "input-field" %>
      </div>
      <div>
        <%= f.label :phone, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.telephone_field :phone, class: "input-field" %>
      </div>
      <div>
        <%= f.label :email, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, class: "input-field" %>
      </div>
      <div>
        <%= f.label :whatsapp, "WhatsApp Number", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.telephone_field :whatsapp, class: "input-field" %>
        <p class="mt-1 text-xs text-gray-500">Used for customer chat and staff alert links (wa.me).</p>
      </div>
      <div class="md:col-span-2">
        <label class="flex items-center gap-3 text-sm text-gray-700">
          <%= f.check_box :whatsapp_notifications_enabled, class: "rounded border-gray-300 text-honda-red focus:ring-honda-red" %>
          Enable WhatsApp staff alerts for new enquiries, test rides, service bookings, and sales
        </label>
      </div>
      <div class="md:col-span-2">
        <%= f.label :google_map_embed_url, "Google Map Embed URL", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.url_field :google_map_embed_url, class: "input-field" %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :google_map_link, "Google Maps Directions Link", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.url_field :google_map_link, class: "input-field", placeholder: "https://maps.google.com/..." %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :business_hours, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_area :business_hours, rows: 4, class: "input-field", placeholder: "Mon–Sat: 9:00 AM – 7:00 PM" %>
      </div>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="font-display text-lg font-semibold text-honda-dark">GST & Billing</h2>
    <p class="mt-1 text-sm text-gray-500">Required to issue tax invoices. Ex-showroom is treated as GST-inclusive.</p>
    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= f.label :gstin, "GSTIN", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :gstin, class: "input-field", maxlength: 15, placeholder: "09AAAAA0000A1Z5" %>
      </div>
      <div>
        <%= f.label :pan, "PAN", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :pan, class: "input-field", maxlength: 10, placeholder: "AAAAA0000A" %>
      </div>
      <div>
        <%= f.label :state, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :state, class: "input-field", placeholder: "e.g. Uttar Pradesh" %>
      </div>
      <div>
        <%= f.label :state_code, "GST state code", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :state_code, class: "input-field", maxlength: 2, placeholder: "09" %>
      </div>
      <div>
        <%= f.label :invoice_prefix, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :invoice_prefix, class: "input-field", placeholder: "SBH" %>
        <p class="mt-1 text-xs text-gray-500">Invoice numbers look like SBH/2026-27/0001.</p>
      </div>
      <div>
        <%= f.label :vehicle_hsn, "Vehicle HSN", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :vehicle_hsn, class: "input-field", placeholder: "8711" %>
      </div>
      <div>
        <%= f.label :vehicle_gst_rate, "Vehicle GST %", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.number_field :vehicle_gst_rate, step: 0.01, class: "input-field" %>
      </div>
      <div>
        <%= f.label :accessories_hsn, "Accessories HSN", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :accessories_hsn, class: "input-field", placeholder: "871410" %>
      </div>
      <div>
        <%= f.label :accessories_gst_rate, "Accessories GST %", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.number_field :accessories_gst_rate, step: 0.01, class: "input-field" %>
      </div>
      <div>
        <%= f.label :handling_hsn, "Handling / documentation HSN", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :handling_hsn, class: "input-field", placeholder: "998599" %>
      </div>
      <div>
        <%= f.label :handling_gst_rate, "Handling GST %", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.number_field :handling_gst_rate, step: 0.01, class: "input-field" %>
      </div>
      <div>
        <%= f.label :labour_sac, "Workshop labour SAC", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :labour_sac, class: "input-field", placeholder: "998714" %>
      </div>
      <div>
        <%= f.label :labour_gst_rate, "Labour GST %", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.number_field :labour_gst_rate, step: 0.01, class: "input-field" %>
      </div>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="font-display text-lg font-semibold text-honda-dark">Bank, UPI & invoice terms</h2>
    <p class="mt-1 text-sm text-gray-500">Printed on tax invoices and credit notes.</p>
    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= f.label :bank_name, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :bank_name, class: "input-field" %>
      </div>
      <div>
        <%= f.label :bank_account_number, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :bank_account_number, class: "input-field" %>
      </div>
      <div>
        <%= f.label :bank_ifsc, "IFSC", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :bank_ifsc, class: "input-field" %>
      </div>
      <div>
        <%= f.label :upi_id, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :upi_id, class: "input-field" %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :billing_terms, "Terms printed on invoice", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_area :billing_terms, rows: 4, class: "input-field" %>
      </div>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="font-display text-lg font-semibold text-honda-dark">Social Media</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= f.label :facebook, "Facebook URL", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.url_field :facebook, class: "input-field" %>
      </div>
      <div>
        <%= f.label :instagram, "Instagram URL", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.url_field :instagram, class: "input-field" %>
      </div>
      <div>
        <%= f.label :youtube, "YouTube URL", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.url_field :youtube, class: "input-field" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "Save Settings", class: "btn-primary cursor-pointer" %>
  </div>
<% end %>
