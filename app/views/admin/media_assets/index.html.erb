<% content_for :page_title, "Media Library" %>
<% content_for :page_subtitle, "Upload and manage media assets" %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <%= search_form_for @q, url: admin_media_assets_path, class: "flex flex-wrap items-end gap-3" do |f| %>
    <div>
      <%= f.label :title_cont, "Title", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.search_field :title_cont, class: "input-field w-48", placeholder: "Search..." %>
    </div>
    <div>
      <%= f.label :file_type_eq, "Type", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.select :file_type_eq, [["Image", "image"], ["Document", "document"]], { include_blank: "All" }, class: "input-field w-36" %>
    </div>
    <div class="flex gap-2">
      <%= f.submit "Search", class: "btn-primary" %>
      <%= link_to "Reset", admin_media_assets_path, class: "btn-secondary" %>
    </div>
  <% end %>
  <%= link_to "Upload Asset", new_admin_media_asset_path, class: "btn-primary shrink-0" %>
</div>

<% if @media_assets.any? %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
    <% @media_assets.each do |asset| %>
      <div class="card group overflow-hidden transition hover:shadow-md">
        <div class="aspect-video bg-gray-100">
          <% if asset.file.attached? && asset.file_type == "image" %>
            <%= image_tag asset.file, class: "h-full w-full object-cover" %>
          <% elsif asset.file.attached? %>
            <div class="flex h-full flex-col items-center justify-center text-gray-400">
              <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
              </svg>
              <span class="mt-2 text-xs font-medium uppercase"><%= asset.file.content_type.split("/").last %></span>
            </div>
          <% else %>
            <div class="flex h-full items-center justify-center text-sm text-gray-400">No file</div>
          <% end %>
        </div>
        <div class="p-4">
          <h3 class="truncate text-sm font-semibold text-honda-dark"><%= asset.title %></h3>
          <% if asset.description.present? %>
            <p class="mt-1 line-clamp-2 text-xs text-gray-500"><%= asset.description %></p>
          <% end %>
          <div class="mt-3 flex items-center justify-between">
            <span class="text-xs text-gray-400"><%= asset.created_at.strftime("%d %b %Y") %></span>
            <% if asset.file.attached? %>
              <%= link_to "Download", rails_blob_path(asset.file, disposition: "attachment"), class: "text-xs font-semibold text-honda-red hover:text-red-700" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <% if @pagy.pages > 1 %><div class="mt-6 flex justify-center"><%== pagy_nav(@pagy) %></div><% end %>
<% else %>
  <%= render "shared/empty_state", title: "No media assets", message: "Upload images and documents to your media library.", cta_text: "Upload Asset", cta_path: new_admin_media_asset_path %>
<% end %>
