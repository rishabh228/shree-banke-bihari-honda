<%# locals: (notes:, pdf_path:, bordered: true) %>
<% if notes.any? %>
  <div class="<%= bordered ? "mt-6 border-t border-gray-100 pt-4" : "" %>">
    <h3 class="text-sm font-medium text-gray-700">Credit notes</h3>
    <ul class="mt-2 divide-y divide-gray-100 text-sm">
      <% notes.each do |note| %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <span>
            <span class="font-medium"><%= note.credit_note_number %></span>
            <span class="text-gray-500">· <%= note.display_kind %> · <%= format_amount(note.grand_total) %></span>
          </span>
          <%= link_to "PDF", pdf_path.call(note), class: "font-semibold text-honda-red", data: { turbo: false } %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
