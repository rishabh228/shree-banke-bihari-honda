<% content_for :page_title, "Enquiry ##{@enquiry.id}" %>
<% content_for :page_subtitle, @enquiry.name %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <div class="flex flex-wrap items-center gap-3">
    <%= render "shared/status_badge", status: @enquiry.status %>
    <span class="text-sm text-gray-500">Source: <%= @enquiry.source_label %></span>
  </div>
  <div class="flex gap-2">
    <% if policy(Sale).create? && @enquiry.bike.present? %>
      <%= button_to "Create Quotation", convert_to_sale_admin_enquiry_path(@enquiry), method: :post, class: "btn-primary" %>
    <% end %>
    <% if @enquiry.phone.present? %>
      <%= link_to whatsapp_url(@enquiry.phone, "Hi #{@enquiry.name}, this is #{current_settings.showroom_name}. Thank you for your enquiry."),
            target: "_blank", rel: "noopener noreferrer",
            class: "inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#1fb855]" do %>
        Reply on WhatsApp
      <% end %>
    <% end %>
    <%= link_to "Edit", edit_admin_enquiry_path(@enquiry), class: "btn-secondary" %>
    <%= button_to "Delete", admin_enquiry_path(@enquiry), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "rounded-lg border border-red-200 bg-red-50 px-5 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100" %>
  </div>
</div>

<div class="card p-6">
  <h2 class="font-display text-lg font-semibold text-honda-dark">Enquiry Details</h2>
  <dl class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div><dt class="text-xs text-gray-500">Name</dt><dd class="text-sm font-medium"><%= @enquiry.name %></dd></div>
    <div><dt class="text-xs text-gray-500">Phone</dt><dd class="text-sm font-medium"><%= @enquiry.phone %></dd></div>
    <div><dt class="text-xs text-gray-500">Email</dt><dd class="text-sm font-medium"><%= @enquiry.email.presence || "—" %></dd></div>
    <div><dt class="text-xs text-gray-500">Bike</dt><dd class="text-sm font-medium"><%= @enquiry.bike&.name || "—" %></dd></div>
    <div><dt class="text-xs text-gray-500">Submitted</dt><dd class="text-sm font-medium"><%= @enquiry.created_at.strftime("%d %b %Y, %I:%M %p") %></dd></div>
  </dl>
  <% if @enquiry.message.present? %>
    <div class="mt-6 border-t border-gray-200 pt-4">
      <dt class="text-xs text-gray-500">Message</dt>
      <dd class="mt-2 text-sm leading-relaxed text-gray-700"><%= simple_format @enquiry.message %></dd>
    </div>
  <% end %>
</div>
