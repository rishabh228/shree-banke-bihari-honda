<% content_for :page_title, "Enquiries" %>
<% content_for :page_subtitle, "Customer enquiries and leads" %>

<div class="mb-6">
  <%= search_form_for @q, url: admin_enquiries_path, class: "flex flex-wrap items-end gap-3" do |f| %>
    <div>
      <%= f.label :name_cont, "Name", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.search_field :name_cont, class: "input-field w-44", placeholder: "Search..." %>
    </div>
    <div>
      <%= f.label :source_eq, "Source", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.select :source_eq, Enquiry.sources.map { |k, v| [k.humanize.titleize, v] }, { include_blank: "All" }, class: "input-field w-40" %>
    </div>
    <div>
      <%= f.label :status_eq, "Status", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.select :status_eq, Enquiry.statuses.map { |k, v| [k.humanize.titleize, v] }, { include_blank: "All" }, class: "input-field w-40" %>
    </div>
    <div class="flex gap-2">
      <%= f.submit "Search", class: "btn-primary" %>
      <%= link_to "Reset", admin_enquiries_path, class: "btn-secondary" %>
      <%= render "shared/pdf_download_button", path: export_pdf_admin_enquiries_path(q: export_ransack_params_for(Enquiry)) %>
    </div>
  <% end %>
</div>

<% if @enquiries.any? %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Customer</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Source</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Bike</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Date</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Status</th>
            <th class="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @enquiries.each do |enquiry| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-honda-dark"><%= enquiry.name %></div>
                <div class="text-sm text-gray-500"><%= enquiry.phone %></div>
              </td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= enquiry.source_label %></td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= enquiry.bike&.name || "—" %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= enquiry.created_at.strftime("%d %b %Y") %></td>
              <td class="px-6 py-4"><%= render "shared/status_badge", status: enquiry.status %></td>
              <td class="px-6 py-4 text-right text-sm">
                <%= link_to "View", admin_enquiry_path(enquiry), class: "font-semibold text-honda-red hover:text-red-700" %>
                <%= link_to "Edit", edit_admin_enquiry_path(enquiry), class: "ml-3 font-semibold text-gray-600 hover:text-honda-dark" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.pages > 1 %><div class="mt-6 flex justify-center"><%== pagy_nav(@pagy) %></div><% end %>
<% else %>
  <%= render "shared/empty_state", title: "No enquiries found", message: "Customer enquiries will appear here." %>
<% end %>
