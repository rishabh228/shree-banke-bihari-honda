<% content_for :page_title, @bike.name %>
<% content_for :page_subtitle, @bike.category.presence || "Bike details" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <div class="flex flex-wrap items-center gap-3">
    <%= render "shared/status_badge", status: @bike.status %>
    <% if @bike.published_at.present? %>
      <span class="text-sm text-gray-500">Published <%= @bike.published_at.strftime("%d %b %Y") %></span>
    <% end %>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Edit", edit_admin_bike_path(@bike), class: "btn-secondary" %>
    <% if @bike.draft? || @bike.hidden? %>
      <%= button_to "Publish", publish_admin_bike_path(@bike), method: :patch, class: "btn-primary" %>
    <% end %>
    <% if @bike.published? %>
      <%= button_to "Hide", hide_admin_bike_path(@bike), method: :patch, class: "btn-secondary" %>
    <% end %>
    <%= button_to "Delete", admin_bike_path(@bike), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "rounded-lg border border-red-200 bg-red-50 px-5 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100" %>
  </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 space-y-6">
    <div class="card p-6">
      <h2 class="font-display text-lg font-semibold text-honda-dark">Overview</h2>
      <% if @bike.description.present? %>
        <p class="mt-4 text-sm leading-relaxed text-gray-600"><%= simple_format @bike.description %></p>
      <% else %>
        <p class="mt-4 text-sm text-gray-400">No description provided.</p>
      <% end %>

      <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
        <% { "Engine" => @bike.engine, "Mileage" => @bike.mileage, "Power" => @bike.power, "Torque" => @bike.torque, "Fuel Tank" => @bike.fuel_tank, "Weight" => @bike.weight }.each do |label, value| %>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wider text-gray-500"><%= label %></dt>
            <dd class="mt-1 text-sm font-medium text-honda-dark"><%= value.presence || "—" %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <% if @bike.bike_variants.any? %>
      <div class="card overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-4">
          <h2 class="font-display text-lg font-semibold text-honda-dark">Variants & Pricing</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Variant</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Color</th>
                <th class="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-500">Ex-Showroom</th>
                <th class="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-500">Total</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Available</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @bike.bike_variants.each do |variant| %>
                <tr>
                  <td class="px-6 py-3 text-sm font-medium text-honda-dark"><%= variant.name %></td>
                  <td class="px-6 py-3 text-sm text-gray-600"><%= variant.color.presence || "—" %></td>
                  <td class="px-6 py-3 text-right text-sm text-gray-600"><%= format_price(variant.ex_showroom_price) %></td>
                  <td class="px-6 py-3 text-right text-sm font-semibold text-honda-dark"><%= format_price(variant.total_price) %></td>
                  <td class="px-6 py-3 text-sm"><%= variant.available? ? "Yes" : "No" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if @bike.bike_features.any? %>
      <div class="card p-6">
        <h2 class="font-display text-lg font-semibold text-honda-dark">Features</h2>
        <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
          <% @bike.bike_features.each do |feature| %>
            <li class="flex items-center gap-2 text-sm text-gray-700">
              <svg class="h-4 w-4 text-honda-red" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
              <%= feature.title %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @bike.bike_specifications.any? %>
      <div class="card overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-4">
          <h2 class="font-display text-lg font-semibold text-honda-dark">Specifications</h2>
        </div>
        <dl class="divide-y divide-gray-200">
          <% @bike.bike_specifications.each do |spec| %>
            <div class="flex justify-between px-6 py-3">
              <dt class="text-sm text-gray-500"><%= spec.label %></dt>
              <dd class="text-sm font-medium text-honda-dark"><%= spec.value %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  </div>

  <div class="space-y-6">
    <div class="card p-6">
      <h2 class="font-display text-lg font-semibold text-honda-dark">Media</h2>
      <% if @bike.thumbnail.attached? %>
        <%= image_tag @bike.thumbnail, class: "mt-4 w-full rounded-lg object-cover" %>
      <% end %>
      <% if @bike.images.attached? %>
        <div class="mt-4 grid grid-cols-2 gap-2">
          <% @bike.images.each do |image| %>
            <%= image_tag image, class: "rounded-lg object-cover" %>
          <% end %>
        </div>
      <% end %>
      <% if @bike.brochure.attached? %>
        <div class="mt-4">
          <%= link_to "Download Brochure", rails_blob_path(@bike.brochure, disposition: "attachment"), class: "text-sm font-semibold text-honda-red hover:text-red-700" %>
        </div>
      <% end %>
    </div>

    <div class="card p-6">
      <h2 class="font-display text-lg font-semibold text-honda-dark">SEO</h2>
      <dl class="mt-4 space-y-3">
        <div><dt class="text-xs text-gray-500">Title</dt><dd class="text-sm text-honda-dark"><%= @bike.seo_title.presence || "—" %></dd></div>
        <div><dt class="text-xs text-gray-500">Description</dt><dd class="text-sm text-honda-dark"><%= @bike.seo_description.presence || "—" %></dd></div>
        <div><dt class="text-xs text-gray-500">Keywords</dt><dd class="text-sm text-honda-dark"><%= @bike.meta_keywords.presence || "—" %></dd></div>
        <div><dt class="text-xs text-gray-500">Slug</dt><dd class="text-sm font-mono text-gray-600"><%= @bike.slug %></dd></div>
        <div><dt class="text-xs text-gray-500">Starting Price</dt><dd class="text-lg font-bold text-honda-red"><%= format_price(@bike.starting_price) %></dd></div>
      </dl>
    </div>
  </div>
</div>
