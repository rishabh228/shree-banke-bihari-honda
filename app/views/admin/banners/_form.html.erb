<%= form_with model: [:admin, banner], class: "space-y-6" do |f| %>
  <% if banner.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <ul class="list-inside list-disc text-sm text-red-700">
        <% banner.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="card p-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= f.label :title, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :title, class: "input-field" %>
      </div>
      <div>
        <%= f.label :subtitle, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :subtitle, class: "input-field" %>
      </div>
      <div>
        <%= f.label :section, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.select :section, Banner::SECTIONS.map { |s| [s.humanize.titleize, s] }, {}, class: "input-field" %>
      </div>
      <div>
        <%= f.label :position, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.number_field :position, min: 0, class: "input-field" %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :link, "Link URL", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.url_field :link, class: "input-field", placeholder: "https://..." %>
      </div>
      <div>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= f.check_box :active, class: "rounded border-gray-300 text-honda-red focus:ring-honda-red" %>
          Banner is active
        </label>
      </div>
      <div class="md:col-span-2">
        <%= f.label :image, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <% if banner.image.attached? %>
          <div class="mb-3"><%= image_tag banner.image, class: "h-40 rounded-lg object-cover" %></div>
        <% end %>
        <%= f.file_field :image, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:rounded-lg file:border-0 file:bg-honda-red file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-red-700" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancel", admin_banners_path, class: "btn-secondary" %>
  </div>
<% end %>
