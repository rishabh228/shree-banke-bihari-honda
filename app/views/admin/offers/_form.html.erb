<%= form_with model: [:admin, offer], class: "space-y-6" do |f| %>
  <% if offer.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <h3 class="text-sm font-semibold text-red-800"><%= pluralize(offer.errors.count, "error") %> prohibited this offer from being saved:</h3>
      <ul class="mt-2 list-inside list-disc text-sm text-red-700">
        <% offer.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="card p-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="md:col-span-2">
        <%= f.label :title, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :title, class: "input-field", required: true %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :description, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_area :description, rows: 4, class: "input-field" %>
      </div>
      <div>
        <%= f.label :bike_id, "Linked Bike (optional)", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.collection_select :bike_id, Bike.order(:name), :id, :name, { include_blank: "All Bikes" }, class: "input-field" %>
      </div>
      <div>
        <%= f.label :active, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <label class="mt-2 flex items-center gap-2 text-sm text-gray-700">
          <%= f.check_box :active, class: "rounded border-gray-300 text-honda-red focus:ring-honda-red" %>
          Offer is active
        </label>
      </div>
      <div>
        <%= f.label :start_date, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.date_field :start_date, class: "input-field" %>
      </div>
      <div>
        <%= f.label :end_date, class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.date_field :end_date, class: "input-field" %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :banner, "Banner Image", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <% if offer.banner.attached? %>
          <div class="mb-3"><%= image_tag offer.banner, class: "h-32 rounded-lg object-cover" %></div>
        <% end %>
        <%= f.file_field :banner, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:rounded-lg file:border-0 file:bg-honda-red file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-red-700" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancel", offer.persisted? ? admin_offer_path(offer) : admin_offers_path, class: "btn-secondary" %>
  </div>
<% end %>
