<% content_for :page_title, @offer.title %>
<% content_for :page_subtitle, "Offer details" %>

<div class="mb-6 flex flex-wrap gap-2">
  <%= link_to "Edit", edit_admin_offer_path(@offer), class: "btn-secondary" %>
  <%= button_to "Delete", admin_offer_path(@offer), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "rounded-lg border border-red-200 bg-red-50 px-5 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100" %>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 card p-6">
    <div class="flex items-start justify-between">
      <h2 class="font-display text-xl font-semibold text-honda-dark"><%= @offer.title %></h2>
      <% if @offer.expired? %>
        <%= render "shared/status_badge", status: "inactive", label: "Expired" %>
      <% elsif @offer.active? %>
        <%= render "shared/status_badge", status: "active", label: "Active" %>
      <% else %>
        <%= render "shared/status_badge", status: "inactive", label: "Inactive" %>
      <% end %>
    </div>
    <% if @offer.description.present? %>
      <div class="mt-4 text-sm leading-relaxed text-gray-600"><%= simple_format @offer.description %></div>
    <% end %>
    <dl class="mt-6 grid grid-cols-2 gap-4">
      <div><dt class="text-xs text-gray-500">Bike</dt><dd class="text-sm font-medium"><%= @offer.bike&.name || "All Bikes" %></dd></div>
      <div><dt class="text-xs text-gray-500">Start Date</dt><dd class="text-sm font-medium"><%= @offer.start_date&.strftime("%d %b %Y") || "—" %></dd></div>
      <div><dt class="text-xs text-gray-500">End Date</dt><dd class="text-sm font-medium"><%= @offer.end_date&.strftime("%d %b %Y") || "Open" %></dd></div>
      <div><dt class="text-xs text-gray-500">Created</dt><dd class="text-sm font-medium"><%= @offer.created_at.strftime("%d %b %Y") %></dd></div>
    </dl>
  </div>
  <% if @offer.banner.attached? %>
    <div class="card p-6">
      <h3 class="font-display text-lg font-semibold text-honda-dark">Banner</h3>
      <%= image_tag @offer.banner, class: "mt-4 w-full rounded-lg object-cover" %>
    </div>
  <% end %>
</div>
