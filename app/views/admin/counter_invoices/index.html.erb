<% content_for :page_title, "Spare counter" %>
<% content_for :page_subtitle, "Walk-in parts and accessories tax invoices" %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <%= search_form_for @q, url: admin_counter_invoices_path, class: "flex flex-wrap items-end gap-3" do |f| %>
    <div>
      <%= f.label :customer_name_or_invoice_number_cont, "Search", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.search_field :customer_name_or_invoice_number_cont, class: "input-field w-56", placeholder: "Customer or invoice no." %>
    </div>
    <div>
      <%= f.label :kind_eq, "Type", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.select :kind_eq, CounterInvoice.kinds.map { |k, v| [ k.humanize.titleize, v ] }, { include_blank: "All" }, class: "input-field w-40" %>
    </div>
    <div>
      <%= f.label :status_eq, "Status", class: "mb-1 block text-xs font-medium text-gray-500" %>
      <%= f.select :status_eq, CounterInvoice.statuses.map { |k, v| [ k.humanize.titleize, v ] }, { include_blank: "All" }, class: "input-field w-40" %>
    </div>
    <div class="flex gap-2">
      <%= f.submit "Search", class: "btn-primary" %>
      <%= link_to "Reset", admin_counter_invoices_path, class: "btn-secondary" %>
    </div>
  <% end %>
  <%= link_to "New spare bill", new_admin_counter_invoice_path, class: "btn-primary shrink-0" %>
</div>

<% if @counter_invoices.any? %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Invoice</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Customer</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Type</th>
            <th class="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-500">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Status</th>
            <th class="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-500"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @counter_invoices.each do |invoice| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium"><%= invoice.invoice_number.presence || "Draft" %></td>
              <td class="px-6 py-4 text-sm"><%= invoice.customer_name %><div class="text-xs text-gray-500"><%= invoice.phone %></div></td>
              <td class="px-6 py-4 text-sm"><%= invoice.display_kind %></td>
              <td class="px-6 py-4 text-right text-sm font-medium"><%= format_amount(invoice.grand_total) %></td>
              <td class="px-6 py-4"><%= render "shared/status_badge", status: invoice.status %></td>
              <td class="px-6 py-4 text-right text-sm"><%= link_to "Open", admin_counter_invoice_path(invoice), class: "font-semibold text-honda-red" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.pages > 1 %><div class="mt-6 flex justify-center"><%== pagy_nav(@pagy) %></div><% end %>
<% else %>
  <%= render "shared/empty_state", title: "No spare / workshop invoices", message: "Open a walk-in spare bill, or issue a workshop invoice from a service job card.", cta_text: "New spare bill", cta_path: new_admin_counter_invoice_path %>
<% end %>
